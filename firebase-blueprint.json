{
  "entities": {
    "users": {
      "title": "User Profile",
      "description": "User profiles and streak tracking",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "profileImage": { "type": "string" },
        "bio": { "type": "string" },
        "currentStreak": { "type": "number" },
        "longestStreak": { "type": "number" },
        "lastDripDate": { "type": "string" },
        "locationMode": { "type": "string" },
        "city": { "type": "string" },
        "country": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "username", "email", "createdAt"]
    },
    "wardrobeItems": {
      "title": "Wardrobe Item",
      "description": "Clothing items owned by user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "imageUrl": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "subcategory": { "type": "string" },
        "colors": { "type": "array", "items": { "type": "string" } },
        "pattern": { "type": "string" },
        "style": { "type": "string" },
        "season": { "type": "array", "items": { "type": "string" } },
        "formality": { "type": "string" },
        "confidence": { "type": "number" },
        "timesWorn": { "type": "number" },
        "createdAt": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["id", "userId", "imageUrl", "name", "category"]
    },
    "looks": {
      "title": "Outfit Look",
      "description": "Generated or posted outfit combinations",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorHandle": { "type": "string" },
        "authorAvatar": { "type": "string" },
