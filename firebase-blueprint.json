        "weather": { "type": "object" },
        "occasion": { "type": "string" },
        "style": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "feedbackType", "createdAt"]
    },
    "outfitHistory": {
      "title": "Outfit History",
      "description": "History of generated and recommended outfits for personalization",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "itemIds": { "type": "array", "items": { "type": "string" } },
        "weather": { "type": "object" },
        "occasion": { "type": "string" },
        "style": { "type": "string" },
        "generatedAt": { "type": "string" },
        "score": { "type": "number" },
        "selected": { "type": "boolean" },
        "liked": { "type": "boolean" },
        "saved": { "type": "boolean" },
        "worn": { "type": "boolean" }
